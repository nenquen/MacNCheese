# Maintainer: nenquen <https://github.com/nenquen>
pkgname=macncheese-git
_name=MacNCheese
pkgver=r1.0000000
pkgrel=1
pkgdesc="Run the macOS Roblox client on Linux through Darling"
arch=('x86_64')
url="https://github.com/nenquen/MacNCheese"
license=('MIT')
# clang and lld build the shim on first launch, against Darling's own sysroot.
depends=('darling' 'clang' 'lld' 'unzip' 'pipewire-audio' 'python' 'python-gobject' 'gtk4' 'libadwaita' 'webkitgtk-6.0' 'sdl2-compat' 'wayland' 'pkgconf')
makedepends=('git')
optdepends=('mangohud: optional performance overlay')
provides=('macncheese')
conflicts=('macncheese' 'macoblox-git' 'macoblox')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd "$_name"
  local share="$pkgdir/usr/share/macncheese"
  install -d "$share"
  cp -r --no-preserve=ownership launcher branding frameworks shim build_debug_shim.sh "$share/"
  rm -f "$share/launcher/install.sh"
  python -m compileall -q -d /usr/share/macncheese/launcher "$share/launcher"

  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/macncheese/launcher/macncheese-launcher "$pkgdir/usr/bin/macncheese"

  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "branding/icons/macncheese-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/macncheese.png"
  done
  install -Dm644 packaging/org.macncheese.MacNCheese.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/org.macncheese.MacNCheese.URI.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/macncheese-roblox-window.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/org.macncheese.MacNCheese.Studio.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/org.macncheese.MacNCheese.xml -t "$pkgdir/usr/share/mime/packages"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
